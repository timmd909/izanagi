#!/bin/bash

# Maximum number of git log entries to look back before giving up
MAX_LOOK_BACK=50

# Find the most recent merge request
#LAST_MERGE_MSG="`git log -n $MAX_LOOK_BACK --oneline | grep -Ei '^[0-9a-f]{6,20}\s+Merge branch ' | head -n 1`"
LAST_MERGE_MSG="`git log -n $MAX_LOOK_BACK --oneline | grep -Ei '(Merge branch |Merge pull request )' | head -n 1`"
LAST_MERGE_SHA="`echo \"$LAST_MERGE_MSG\" | grep -Eio '^[0-9a-f]+'`"

NUM_COMMITS="`git log --oneline $LAST_MERGE_SHA..HEAD | wc -l`"

if [ $NUM_COMMITS -lt 1 ]; then
  echo "Unable to find last merge after looking back $MAX_LOOK_BACK commits"
  exit 1
fi

git rebase -i HEAD~$NUM_COMMITS
