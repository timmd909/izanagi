#!/bin/bash
#
# Not sure what I was thinking w/ this script....
#

pushd "`dirname $0`" > /dev/null

if [[ "$1" == "" ]]; then
  echo "Usage: $0 <hostname>"
  echo
  echo "Available hosts:"
  echo
  HOSTS="`cat host_vars/hosts.ini | grep -vE '^(#|\[)' | grep -vE '^$' | cut -d\  -f1 | sort | uniq `"
  for HOST in $HOSTS ; do
    echo " * $HOST"
  done
  echo

  exit 42
fi

MACHINE="$1"
shift

( set -x ; ansible -i hosts_vars/hosts.ini "$MACHINE"  -m setup "$@" )

popd > /dev/null
